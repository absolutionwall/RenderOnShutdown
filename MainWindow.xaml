<Window x:Class="RenderOnShutdown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RenderOnShutdown" Height="600" Width="900"
        Icon="icon.png">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="RenderOnShutdown" FontWeight="Bold" VerticalAlignment="Center"/>
            <Ellipse x:Name="StatusIndicator" Width="16" Height="16" Fill="Gray" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <Button Content="Ejecutar ahora" Click="BtnRunNow_Click" Margin="8,0,0,0"/>
            <Button Content="Opciones" Click="BtnOptions_Click" Margin="8,0,0,0"/>
        </StackPanel>

        <ListView x:Name="FilesList" Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <Image Source="{Binding Thumbnail}" Width="120" Height="68" Stretch="UniformToFill" Margin="4"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBox x:Name="LogTextBox" Grid.Row="2" FontFamily="Consolas" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Black" Foreground="Lime"/>
    </Grid>
</Window>
