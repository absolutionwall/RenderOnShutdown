<Window x:Class="RenderOnShutdown.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opciones" Height="320" Width="700"
        Icon="icon.png">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Monitor folder -->
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" /> <!-- FFmpeg -->
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" /> <!-- Command -->
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" /> <!-- Output -->
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" /> <!-- Buttons -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Carpeta Origen:" VerticalAlignment="Center"/>
        <TextBox x:Name="TxtMonitorFolder" Grid.Row="0" Grid.Column="1" Margin="6,0,6,0" />
        <Button Content="Examinar" Grid.Row="0" Grid.Column="2" Click="BtnBrowseMonitor_Click" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="FFmpeg (.exe):" VerticalAlignment="Center"/>
        <TextBox x:Name="TxtFfmpeg" Grid.Row="2" Grid.Column="1" Margin="6,0,6,0" />
        <Button Content="Examinar" Grid.Row="2" Grid.Column="2" Click="BtnBrowseFfmpeg_Click" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Command (plantilla):" VerticalAlignment="Top"/>
        <TextBox x:Name="TxtCommand" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Height="80" TextWrapping="Wrap" Margin="6,0,0,0"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Output Folder:" VerticalAlignment="Center"/>
        <TextBox x:Name="TxtOutputFolder" Grid.Row="6" Grid.Column="1" Margin="6,0,6,0" />
        <Button Content="Examinar" Grid.Row="6" Grid.Column="2" Click="BtnBrowseOutput_Click" />

        <StackPanel Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Guardar" Click="BtnSave_Click" Width="100" Margin="0,0,8,0"/>
            <Button Content="Cancelar" Click="BtnCancel_Click" Width="100"/>
        </StackPanel>
    </Grid>
</Window>
